{
 "uid": "oxchange-kafka-db",
 "title": "Oxchange: Kafka and database",
 "description": "Consumer lag, outbox depth, connection use and slow queries.",
 "tags": [
  "oxchange"
 ],
 "timezone": "browser",
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "schemaVersion": 39,
 "editable": true,
 "panels": [
  {
   "type": "timeseries",
   "title": "Consumer lag",
   "description": "Alert: more than 50,000 for 2 minutes",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max by (service, topic, partition) (consumer_lag)",
     "legendFormat": "{{service}} {{topic}}/{{partition}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 1
  },
  {
   "type": "timeseries",
   "title": "Outbox waiting",
   "description": "Alert: more than 10,000 for 1 minute",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max by (service) (outbox_unpublished)",
     "legendFormat": "{{service}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 2
  },
  {
   "type": "timeseries",
   "title": "Outbox to Kafka (p99)",
   "description": "Saved in the outbox to confirmed by Kafka",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum by (le, topic) (rate(outbox_publish_seconds_bucket[5m])))",
     "legendFormat": "p99 {{topic}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 3
  },
  {
   "type": "timeseries",
   "title": "Pool connections in use",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (service) (db_pool_connections{state=\"in_use\"})",
     "legendFormat": "in use {{service}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "expr": "max by (service) (db_pool_max_connections)",
     "legendFormat": "max {{service}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 4
  },
  {
   "type": "timeseries",
   "title": "Slow queries (over 1 s)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (service) (rate(db_slow_queries_total[5m]))",
     "legendFormat": "{{service}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "PostgreSQL connections by database",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (datname) (pg_stat_activity_count)",
     "legendFormat": "{{datname}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "Longest open transaction",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max by (datname) (pg_stat_activity_max_tx_duration)",
     "legendFormat": "{{datname}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "gRPC latency by method (p99)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum by (le, method) (rate(grpc_request_duration_seconds_bucket[5m])))",
     "legendFormat": "p99 {{method}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "gridPos": {
    "w": 12,
